# Client-safe Supabase configuration (Vite exposed)
# If left empty, the application runs with an intelligent, persistent local data engine pre-seeded with sample farm data for instant testing!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secrets (Netlify Functions environment variables - NEVER expose with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GOOGLE_SERVICE_ACCOUNT_EMAIL=sync-bot@your-gcp-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-id
# APP_TIMEZONE=Asia/Kolkata
# APP_CURRENCY=INR
